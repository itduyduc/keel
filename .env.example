# Copy to .env for local runs (.env is gitignored). On the server these live in /etc/plumb.env.

# where it listens, and the address people use
PORT=4747
HOST=127.0.0.1
PLUMB_PUBLIC_URL=http://localhost:4747
# PLUMB_DATA_DIR=            # default: ./data (use /var/lib/plumb on the server)

# always admins, created on start if missing (comma-separated)
PLUMB_ADMIN_EMAILS=

# the team — read on the FIRST start only, when the database is created
PLUMB_TEAM_NAME=Team
PLUMB_TEAM_KEY=TM                 # issues are TM-1, TM-2, …
PLUMB_FIRST_ISSUE_NUMBER=1        # moving from another tracker? continue its count, e.g. 79
# PLUMB_CYCLE_ANCHOR=             # a Monday, YYYY-MM-DD, that cycle 1 starts on; default: this week's
# PLUMB_TIMEZONE=                 # IANA zone for cycle boundaries; default: the server's

# named on /privacy.html, which the Google consent screen links to
PLUMB_OPERATOR_NAME=
PLUMB_CONTACT_EMAIL=

# Google OAuth client (Web application). Redirect URI: <PLUMB_PUBLIC_URL>/auth/google/callback
PLUMB_GOOGLE_CLIENT_ID=
PLUMB_GOOGLE_CLIENT_SECRET=

# local development only: sign in as any member without Google (answers on localhost only)
PLUMB_DEV_LOGIN=

# GitHub (optional): the org whose pull requests link to issues, the org webhook's
# secret (instant updates) and a read-only token for the catch-up poll
PLUMB_GITHUB_ORG=
PLUMB_GITHUB_WEBHOOK_SECRET=
PLUMB_GITHUB_TOKEN=
PLUMB_GITHUB_POLL_SECONDS=120
