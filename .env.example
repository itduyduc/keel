# Copy to .env for local runs (.env is gitignored). On the server these live in /etc/keel.env.

# where it listens, and the address people use
PORT=4747
HOST=127.0.0.1
KEEL_PUBLIC_URL=http://localhost:4747
# KEEL_DATA_DIR=            # default: ./data (use /var/lib/keel on the server)

# always admins, created on start if missing (comma-separated)
KEEL_ADMIN_EMAILS=

# the team — read on the FIRST start only, when the database is created
KEEL_TEAM_NAME=Team
KEEL_TEAM_KEY=TM                 # issues are TM-1, TM-2, …
KEEL_FIRST_ISSUE_NUMBER=1        # moving from another tracker? continue its count, e.g. 79
# KEEL_CYCLE_ANCHOR=             # a Monday, YYYY-MM-DD, that cycle 1 starts on; default: this week's
# KEEL_TIMEZONE=                 # IANA zone for cycle boundaries; default: the server's

# named on /privacy.html, which the Google consent screen links to
KEEL_OPERATOR_NAME=
KEEL_CONTACT_EMAIL=

# Google OAuth client (Web application). Redirect URI: <KEEL_PUBLIC_URL>/auth/google/callback
KEEL_GOOGLE_CLIENT_ID=
KEEL_GOOGLE_CLIENT_SECRET=

# local development only: sign in as any member without Google (answers on localhost only)
KEEL_DEV_LOGIN=

# GitHub (optional): the org whose pull requests link to issues, the org webhook's
# secret (instant updates) and a read-only token for the catch-up poll
KEEL_GITHUB_ORG=
KEEL_GITHUB_WEBHOOK_SECRET=
KEEL_GITHUB_TOKEN=
KEEL_GITHUB_POLL_SECONDS=120
