{
  "name": "plumb",
  "private": true,
  "type": "module",
  "description": "Plumb: a minimal Linear clone for the PiCubed team",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "NODE_NO_WARNINGS=1 node server/index.js",
    "dev": "PLUMB_DEV_LOGIN=1 NODE_NO_WARNINGS=1 node --watch-path=server server/index.js",
    "test": "NODE_NO_WARNINGS=1 node --test test/*.test.mjs",
    "build": "npm --prefix web run build"
  }
}
