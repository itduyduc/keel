# Copy to deploy/deploy.env (gitignored). Read by scripts/setup-vm.sh, deploy.sh and backup.sh,
# which drive a Google Cloud VM with gcloud. Any Linux box with systemd and Caddy works the
# same way by hand: deploy/keel.service, deploy/Caddyfile.template, code in /opt/keel.
GCP_PROJECT=
GCP_ZONE=us-west1-b
VM=
VM_IP=                       # the VM's public address; DNS must point DOMAIN at it
DOMAIN=                      # e.g. tracker.example.com
ADMIN_EMAIL=                 # the first admin; more can be invited from Settings
BACKUP_DIR=$HOME/Backups/keel   # where backup.sh keeps the newest 7 snapshots
