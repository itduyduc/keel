# /etc/systemd/system/plumb.service — installed by scripts/setup-vm.sh
[Unit]
Description=Plumb (issue tracker for the PiCubed team)
After=network-online.target
Wants=network-online.target

[Service]
User=plumb
Group=plumb
WorkingDirectory=/opt/plumb
# code lives in /opt/plumb, data in /var/lib/plumb: a redeploy can never touch plumb.db
EnvironmentFile=/etc/plumb.env
Environment=NODE_ENV=production NODE_NO_WARNINGS=1 PLUMB_SKIP_ENV_FILE=1 PLUMB_DATA_DIR=/var/lib/plumb PLUMB_WEB_DIR=/opt/plumb/web/dist
ExecStart=/usr/bin/node /opt/plumb/server/index.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/plumb

[Install]
WantedBy=multi-user.target
